# 复制为 backend/.env 或 /opt/blog/.env 后填写；不要提交真实密钥。
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DB_PATH=./data/blog.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SITE_URL=http://localhost:4321
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4321
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_STATIC_BUCKET=blog-static
QINIU_ASSET_BUCKET=blog-assets
QINIU_ASSET_DOMAIN=
GITHUB_TOKEN=
GITHUB_REPO=jishenghui/Tech-blog

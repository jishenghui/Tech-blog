---
import ArticleCard from '../../components/ArticleCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { apiGet } from '../../lib/api'
import type { DirectoryPage, NavNode } from '../../lib/types'

export async function getStaticPaths() {
  const nav = await apiGet<NavNode[]>('/api/v1/nav')
  return nav
    .filter((node) => node.kind === 'container')
    .map((node) => ({ params: { category: node.slug }, props: { category: node } }))
}

interface Props {
  category: NavNode
}

const { category } = Astro.props
const children = category.children ?? []
const result = await apiGet<DirectoryPage>(
  `/api/v1/directories/${category.slug}?page=1&page_size=20`,
)
---

<BaseLayout
  title={category.name}
  description={`${category.name}目录下的文章与子目录。`}
  active={category.slug}
>
  <section class="container page-shell">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">首页</a><span>/</span>
      <span>{category.name}</span>
    </nav>

    <header class="page-head">
      <p class="eyebrow">DIRECTORY / {category.slug}</p>
      <h1 class="page-title">{category.name}</h1>
      <p class="page-subtitle">
        {result.directory.description || `共 ${result.total} 篇已发布文章。`}
      </p>
    </header>

    {
      children.length > 0 && (
        <section class="section-block" style="margin-top:0;">
          <h2>子目录</h2>
          <div class="tag-grid">
            {children.map((child) => (
              <a class="tag-card" href={`/${category.slug}/${child.slug}/`}>
                <strong>{child.name}</strong>
                <span>目录</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      result.items.length > 0 ? (
        <section class="section-block">
          <h2>最新文章</h2>
          <div class="article-list">
            {result.items.map((article) => <ArticleCard article={article} showDirectory />)}
          </div>
          {result.total > result.items.length && children.length > 0 && (
            <p class="section-note">更多文章请进入对应的二级目录。</p>
          )}
        </section>
      ) : (
        <div class="empty-state">这个目录下还没有已发布文章。</div>
      )
    }
  </section>
</BaseLayout>
